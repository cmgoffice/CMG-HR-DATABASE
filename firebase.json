{
  "projectId": "cmg-hr-database",
  "functions": {
    "source": "functions",
    "predeploy": [
      "node scripts/syncFunctionsEnv.js"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/zkteco/attendance",
        "function": {
          "functionId": "zktecoAttendance",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/zkteco/sync",
        "function": {
          "functionId": "zktecoSyncNow",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
